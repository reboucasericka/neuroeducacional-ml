# DEVELOPMENT / local only — copy to .env and adjust.
# Never commit real secrets. Never use demo credentials in production.

# Prefer a strong random value in any shared/staging/production deploy.
SECRET_KEY=change-me-dev-only

# Optional alias also supported: NEUROLEARN_SECRET_KEY

# SQLite local (default path is data/processed/neurolearn_platform.db if unset)
# DATABASE_URL=sqlite:///C:/path/to/neurolearn_platform.db
# NEUROLEARN_DATABASE_URL=...

# Cookie Secure: leave unset/false on localhost HTTP.
# In production HTTPS set:
# SESSION_COOKIE_SECURE=1

# Demo seed (professional + patients fictícios). Set 0 to disable.
NEUROLEARN_SEED_DEMO=1

# Flask debug (DEVELOPMENT ONLY). Production: 0 / false.
FLASK_DEBUG=1
