# Variáveis de ambiente — copie para `.env` (nunca faça commit do `.env`).
# DEVELOPMENT / local only. Sem secrets reais neste ficheiro.

# --- Ambiente ---
# development | testing | production
FLASK_ENV=development

# Flask debug (DEVELOPMENT ONLY). Em production fica forçado a false.
FLASK_DEBUG=1

# --- Segurança ---
# Em development pode omitir (usa fallback local).
# Em production é OBRIGATÓRIO um valor forte e único.
SECRET_KEY=change-me-dev-only
# Alias suportado:
# NEUROLEARN_SECRET_KEY=

# Cookie Secure: em localhost HTTP deixar unset/false.
# Em production HTTPS: 1
# SESSION_COOKIE_SECURE=0

# --- Base de dados ---
# Por omissão: data/processed/neurolearn_platform.db (SQLite — desenvolvimento/demo).
# DATABASE_URL=sqlite:///./data/processed/neurolearn_platform.db
# NEUROLEARN_DATABASE_URL=

# --- Seed demonstrativo ---
# 1 = cria conta demo + pacientes fictícios (development).
# Em production o default é 0 (desligado). Nunca ative em deploy público.
NEUROLEARN_SEED_DEMO=1
